                        ;-----------------------------------------------------
                        ;  SNAKE - Version 2
                        ;
                        ;  Direct 6502 implementation of the Applesoft BASIC v
                        ;
                        ;  Goals of Version 2:
                        ;
                        ;    - Preserve the BASIC game algorithm
                        ;    - Use 8-bit integer X/Y coordinates
                        ;    - Use 8-bit snake indexes
                        ;    - Use one complete page for the snake arrays
                        ;    - Use Apple II monitor ROM for graphics 
                        ;    - Optimize for code size to fit 256 bytes boot se
                        ;
                        ;  Snake memory:
                        ;
                        ;    $3000-$30FF    SX[0..127]
                        ;    $3100-$31FF    SY[0..127]
                        ;-----------------------------------------------------
                        
                                title   "Snake Version 2"
                                code
0801 =                          org     $0801
                        
                        ;-----------------------------------------------------
                        ; Apple II hardware
                        ;-----------------------------------------------------
                        
c000 =                  KBD             equ     $C000
c010 =                  KBDSTRB         equ     $C010
c030 =                  SPKR            equ     $C030
c0e8 =                  DRVMOTOR        equ     $C0E8
                        
                        ;-----------------------------------------------------
                        ; Apple II monitor routines
                        ;-----------------------------------------------------
                        
e003 =                  BASIC           equ     $E003
                        
f800 =                  PLOT            equ     $F800
f819 =                  HLINE           equ     $F819
f828 =                  VLINE           equ     $F828
f871 =                  SCRN            equ     $F871
                        
fb40 =                  SETGR           equ     $FB40
                        
fca8 =                  WAIT            equ     $FCA8
ff3a =                  BELL            equ     $FF3A
fbe4 =                  BELL2           equ     $FBE4
                        
fdda =                  PRBYTE          equ     $FDDA
                        
                        ;-----------------------------------------------------
                        ; Monitor zero-page locations
                        ;-----------------------------------------------------
                        
0020 =                  WNDLFT          equ     $20
0021 =                  WNDWDTH         equ     $21
0022 =                  WNDTOP          equ     $22
0023 =                  WNDBTM          equ     $23
                        
AS65 Assembler for R6502 [1.42].                                     Page    2
------------------------------ Snake Version 2 -------------------------------

0024 =                  CH              equ     $24
0025 =                  CV              equ     $25
                        
0026 =                  GBASL           equ     $26
0027 =                  GBASH           equ     $27
                        
0028 =                  BASL            equ     $28
0029 =                  BASH            equ     $29
                        
002c =                  H2              equ     $2C
002d =                  V2              equ     $2D
                        
0030 =                  COLOR           equ     $30
                        
                        ;-----------------------------------------------------
                        ; Game variables
                        ;-----------------------------------------------------
                        
0051 =                  DX              equ     $51
0052 =                  DY              equ     $52
                        
0053 =                  TA              equ     $53
0054 =                  HE              equ     $54
                        
0055 =                  GW              equ     $55
0056 =                  DE              equ     $56
                        
                        ;-----------------------------------------------------
                        ; Snake arrays
                        ;
                        ; One complete 256-byte page.
                        ;
                        ;   SX[0..127] = $3000-$307F
                        ;   SY[0..127] = $3080-$30FF
                        ;-----------------------------------------------------
                        
3000 =                  SX              equ     $3000
3100 =                  SY              equ     $3100
                        
                        ;-----------------------------------------------------
                        ; Colors
                        ;-----------------------------------------------------
                        
0000 =                  BLACK           equ     $00 ; Currently not used direc
0011 =                  RED             equ     $11
00cc =                  SNAKECOLOR      equ     $CC
00ff =                  WHITE           equ     $FF ; Currently not used direc
                        
                        ;=====================================================
                        ; START
                        ;=====================================================
                        
0801 :                  START
                        
                        ;-----------------------------------------------------
                        ; Turn off disk drive motor
                        ;-----------------------------------------------------
                        
                                ;lda     DRVMOTOR
0801 : bd88c0                   lda     $C088,x
                        
                        ;=====================================================
AS65 Assembler for R6502 [1.42].                                     Page    3
